# ============================================================================
#  DF VPN Bot — образец конфигурации.
#  Скопируйте в .env  →  cp .env.example .env  и заполните значения.
#  Файл .env в git не попадает (см. .gitignore).
# ============================================================================

# --- Telegram (обязательно) -------------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Telegram ID администраторов (через запятую). Узнать: @userinfobot
ADMIN_IDS=123456789
# Название сервиса в приветствии
BOT_NAME=DF VPN
# Поддержка (без @) — показывается в кнопках
SUPPORT_USERNAME=support
# Ссылка на новостной канал (необязательно)
NEWS_CHANNEL_URL=
# Обязательная подписка на каналы для пользователей, например: @channel1,@channel2
# Бот должен быть администратором этих каналов, иначе проверка не сработает
REQUIRED_CHANNELS=

# --- Тарифы, продажи --------------------------------------------------------
CURRENCY=₽
# Пробный период
TRIAL_ENABLED=false
TRIAL_DAYS=3
TRIAL_DEVICES=1
TRIAL_TRAFFIC_GB=10
# Реферальная программа
REF_PERCENT=15
REF_WELCOME_BONUS=0
REF_MIN_PAYOUT=100
# Способы оплаты: yookassa, stars, balance, manual (можно несколько через запятую)
PAYMENT_METHODS=yookassa,stars,balance,manual

# --- ЮKassa (карты РФ, СБП) -------------------------------------------------
# Магазин и секретный ключ: https://yookassa.ru/my/i/integration/api-keys
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда возвращать пользователя после оплаты (можно ссылку на бота)
YOOKASSA_RETURN_URL=https://t.me
# Тестовый магазин ЮKassa (ключи test_*)
YOOKASSA_TEST=false

# --- Telegram Stars ---------------------------------------------------------
# Сколько рублей «стоит» 1 звезда (используется для пересчёта цены в ⭐️)
STARS_RATE=1.5

# --- Баланс -----------------------------------------------------------------
MIN_TOPUP=100
MAX_TOPUP=50000
MANUAL_PAYMENT_NOTE=Оплата переводом: напишите в поддержку, мы дадим реквизиты и подтвердим платёж вручную.

# --- Вебхуки ЮKassa (рекомендуется) -----------------------------------------
# Включите, если у бота есть публичный HTTPS-адрес (домен + nginx/caddy).
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/yookassa/webhook
# ВАЖНО: этот же адрес нужно указать в кабинете ЮKassa → Интеграция → HTTP-уведомления
WEBHOOK_PUBLIC_URL=https://bot.example.com/yookassa/webhook

# ============================================================================
#  ВЫДАЧА КЛЮЧЕЙ: VPN_PANEL = pool | xui | marzban
# ============================================================================

# --- Режим 1: пул готовых конфигов (ничего больше не нужно) -----------------
# Ключи загружаются в админке: 🔑 Ключи → ➕ Добавить ключи
VPN_PANEL=pool

# --- Режим 2: панель 3x-ui ---------------------------------------------------
# XUI_URL — адрес панели вместе с путём, если он изменён
XUI_URL=http://127.0.0.1:2053
XUI_USERNAME=admin
XUI_PASSWORD=
# Либо API-токен (Настройки → Безопасность → API Token) — предпочтительнее
XUI_API_TOKEN=
# ID inbound'а, к которому добавлять клиентов (посмотреть: /panel/inbounds/list или в веб-панели)
XUI_INBOUND_ID=1
# Публичный адрес сервера для ссылок (если отличается от адреса панели), например vpn.example.com
XUI_PUBLIC_HOST=
# База ссылки подписки 3x-ui, если включена подписка, например https://sub.example.com/sub
XUI_SUB_BASE=

# --- Режим 3: панель Marzban -------------------------------------------------
MARZBAN_URL=https://panel.example.com
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=
# Какие протоколы/инбаунды выдавать (JSON)
MARZBAN_PROXIES_JSON={"vless": {"flow": "xtls-rprx-vision"}}
MARZBAN_INBOUNDS_JSON={"vless": ["VLESS TCP REALITY"]}
MARZBAN_VERIFY_SSL=true

# --- Служебное ---------------------------------------------------------------
DB_PATH=data/dfvpnbot.sqlite3
LOG_LEVEL=INFO
LOG_FILE=data/bot.log
# Отключать клиента в панели по истечении подписки
AUTO_DISABLE_EXPIRED=true
# За сколько дней предупреждать об окончании подписки
NOTIFY_DAYS_BEFORE=3,1
# Через сколько часов отменять неоплаченные заказы
ORDERS_TTL_HOURS=48
# Анти-спам: минимальный интервал между действиями пользователя, сек
THROTTLING_RATE=0.6
# Свои тексты (необязательно)
TERMS_TEXT=
PRIVACY_TEXT=
